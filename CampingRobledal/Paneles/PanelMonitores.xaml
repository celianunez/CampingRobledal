<UserControl x:Class="CampingRobledal.PanelMonitores"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Buscar:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="txtBuscarMonitor" Width="200" Margin="0,0,16,0"
                     ToolTip="Busca por nombre o especialidad (Ctrl+F)" TextChanged="Filtro_Cambiado"/>
            <TextBlock Text="Idioma:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="cmbFiltroIdioma" Width="120" Margin="0,0,16,0" SelectedIndex="0"
                      ToolTip="Filtra por idioma que habla el monitor" SelectionChanged="Filtro_Cambiado">
                <ComboBoxItem Content="Todos"/>
                <ComboBoxItem Content="Español"/>
                <ComboBoxItem Content="Inglés"/>
                <ComboBoxItem Content="Francés"/>
                <ComboBoxItem Content="Alemán"/>
            </ComboBox>
            <TextBlock Text="Disponibilidad:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="cmbFiltroDisponibilidad" Width="120" Margin="0,0,16,0" SelectedIndex="0"
                      ToolTip="Filtra por disponibilidad" SelectionChanged="Filtro_Cambiado">
                <ComboBoxItem Content="Todos"/>
                <ComboBoxItem Content="Disponible"/>
                <ComboBoxItem Content="De baja"/>
            </ComboBox>
            <Button x:Name="btnLimpiarFiltros" Content="Limpiar filtros" Style="{StaticResource BotonNeutro}" Margin="0"
                    ToolTip="Quita la búsqueda y los filtros" Click="btnLimpiarFiltros_Click"/>
        </WrapPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="340" MinWidth="280"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DataGrid x:Name="dgMonitores" Grid.Row="0" SelectionChanged="dgMonitores_SelectionChanged"
                          MouseDoubleClick="dgMonitores_MouseDoubleClick" KeyDown="dgMonitores_KeyDown"
                          ToolTip="Doble clic para modificar · Supr para dar de baja">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nombre" Binding="{Binding NombreCompleto}" Width="*"/>
                        <DataGridTextColumn Header="Especialidad" Binding="{Binding Especialidad}" Width="180"/>
                        <DataGridTextColumn Header="Idiomas" Binding="{Binding TextoIdiomas}" Width="170"/>
                        <DataGridTextColumn Header="Disponibilidad" Binding="{Binding Disponibilidad}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="btnNuevoMonitor" Content="➕ Nuevo" Style="{StaticResource BotonPrincipal}" Margin="0,4,4,4"
                            ToolTip="Añadir un monitor (Ctrl+N)" Click="btnNuevoMonitor_Click"/>
                    <Button x:Name="btnModificarMonitor" Content="✎ Modificar" Style="{StaticResource BotonNeutro}" IsEnabled="False"
                            ToolTip="Modificar el monitor seleccionado (Intro)" Click="btnModificarMonitor_Click"/>
                    <Button x:Name="btnDarDeBaja" Content="⬇ Dar de baja" Style="{StaticResource BotonPeligro}" IsEnabled="False"
                            ToolTip="Dar de baja al monitor seleccionado (Supr)" Click="btnDarDeBaja_Click"/>
                </StackPanel>
            </Grid>

            <GroupBox Grid.Column="2" Header="Ficha del monitor">
                <Grid>
                    <TextBlock x:Name="lblFichaVaciaMonitor" Style="{StaticResource TextoFichaVacia}"
                               Text="Selecciona un monitor de la tabla para ver su ficha"/>
                    <ScrollViewer x:Name="pnlFichaMonitor" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <!-- Foto provisional: iniciales -->
                                <Border x:Name="imgFotoMonitor" Width="56" Height="56" CornerRadius="28"
                                        Background="{StaticResource ColorAcento}" ToolTip="Foto del monitor">
                                    <TextBlock x:Name="lblInicialesMonitor" Foreground="White" FontSize="20" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="lblFichaNombreMonitor" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                                           VerticalAlignment="Center" Margin="12,0,0,0" MaxWidth="200"/>
                            </StackPanel>
                            <TextBlock x:Name="lblFichaDatosMonitor" TextWrapping="Wrap" LineHeight="20" Margin="0,10,0,0"/>
                            <TextBlock Text="Actividades que imparte" FontWeight="SemiBold" Margin="0,10,0,4"/>
                            <ListBox x:Name="lstActividadesMonitor" MinHeight="40" MaxHeight="120"
                                     ToolTip="Actividades a cargo de este monitor"/>
                            <Button x:Name="btnVerActividades" Content="Ver en Actividades" Style="{StaticResource BotonNeutro}"
                                    HorizontalAlignment="Left" Margin="0,8,0,0"
                                    ToolTip="Ir a la pestaña de actividades" Click="btnVerActividades_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>
