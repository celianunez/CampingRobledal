<UserControl x:Class="CampingRobledal.PanelActividades"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Buscar:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="txtBuscarActividad" Width="180" Margin="0,0,16,0"
                     ToolTip="Busca por nombre de actividad (Ctrl+F)" TextChanged="Filtro_Cambiado"/>
            <TextBlock Text="Destinatarios:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="cmbFiltroDestinatarios" Width="110" Margin="0,0,16,0" SelectedIndex="0"
                      ToolTip="Filtra por público" SelectionChanged="Filtro_Cambiado">
                <ComboBoxItem Content="Todos"/>
                <ComboBoxItem Content="Adultos"/>
                <ComboBoxItem Content="Niños"/>
            </ComboBox>
            <TextBlock Text="Área:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="cmbFiltroArea" Width="140" Margin="0,0,16,0"
                      ToolTip="Filtra por zona del camping donde se realiza" SelectionChanged="Filtro_Cambiado"/>
            <TextBlock Text="Monitor:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="cmbFiltroMonitor" Width="150" Margin="0,0,16,0"
                      ToolTip="Filtra por monitor" SelectionChanged="Filtro_Cambiado"/>
            <Button x:Name="btnLimpiarFiltros" Content="Limpiar filtros" Style="{StaticResource BotonNeutro}" Margin="0"
                    ToolTip="Quita la búsqueda y los filtros" Click="btnLimpiarFiltros_Click"/>
        </WrapPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="340" MinWidth="280"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DataGrid x:Name="dgActividades" Grid.Row="0" SelectionChanged="dgActividades_SelectionChanged"
                          MouseDoubleClick="dgActividades_MouseDoubleClick" KeyDown="dgActividades_KeyDown"
                          ToolTip="Doble clic para modificar · Supr para eliminar">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                        <DataGridTextColumn Header="Destinatarios" Binding="{Binding TextoDestinatarios}" Width="95"/>
                        <DataGridTextColumn Header="Horario" Binding="{Binding Horario}" Width="100"/>
                        <DataGridTextColumn Header="Monitor(es)" Binding="{Binding TextoMonitores}" Width="140"/>
                        <DataGridTextColumn Header="Inscritos" Binding="{Binding TextoCupo}" Width="70"/>
                        <DataGridTextColumn Header="Precio" Binding="{Binding TextoPrecio}" Width="75"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="btnNuevaActividad" Content="➕ Nueva" Style="{StaticResource BotonPrincipal}" Margin="0,4,4,4"
                            ToolTip="Añadir una actividad (Ctrl+N)" Click="btnNuevaActividad_Click"/>
                    <Button x:Name="btnModificarActividad" Content="✎ Modificar" Style="{StaticResource BotonNeutro}" IsEnabled="False"
                            ToolTip="Modificar la actividad seleccionada (Intro)" Click="btnModificarActividad_Click"/>
                    <Button x:Name="btnEliminarActividad" Content="🗑 Eliminar" Style="{StaticResource BotonPeligro}" IsEnabled="False"
                            ToolTip="Eliminar la actividad seleccionada (Supr)" Click="btnEliminarActividad_Click"/>
                </StackPanel>
            </Grid>

            <GroupBox Grid.Column="2" Header="Ficha de la actividad">
                <Grid>
                    <TextBlock x:Name="lblFichaVaciaActividad" Style="{StaticResource TextoFichaVacia}"
                               Text="Selecciona una actividad de la tabla para ver su ficha"/>
                    <ScrollViewer x:Name="pnlFichaActividad" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="lblFichaNombreActividad" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="lblFichaDatosActividad" TextWrapping="Wrap" LineHeight="20" Margin="0,8,0,0"/>
                            <TextBlock Text="Plazas" FontWeight="SemiBold" Margin="0,10,0,4"/>
                            <ProgressBar x:Name="prgCupo" Height="16" Minimum="0" ToolTip="Inscritos sobre el cupo máximo"/>
                            <TextBlock x:Name="lblCupo" Margin="0,4,0,0" Style="{StaticResource TextoAyuda}"/>
                            <Button x:Name="btnVerMonitor" Content="Ver monitor" Style="{StaticResource BotonNeutro}"
                                    HorizontalAlignment="Left" Margin="0,10,0,0"
                                    ToolTip="Ir a la pestaña de monitores" Click="btnVerMonitor_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>
