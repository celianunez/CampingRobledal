<UserControl x:Class="CampingRobledal.PanelParcelas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Buscar:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="txtBuscarParcela" Width="200" Margin="0,0,16,0"
                     ToolTip="Busca por código o nombre de la parcela (Ctrl+F)" TextChanged="Filtro_Cambiado"/>
            <TextBlock Text="Categoría:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="cmbFiltroCategoria" Width="120" Margin="0,0,16,0" SelectedIndex="0"
                      ToolTip="Filtra por categoría de parcela" SelectionChanged="Filtro_Cambiado">
                <ComboBoxItem Content="Todas"/>
                <ComboBoxItem Content="Pequeña"/>
                <ComboBoxItem Content="Mediana"/>
                <ComboBoxItem Content="Grande"/>
                <ComboBoxItem Content="Premium"/>
            </ComboBox>
            <TextBlock Text="Estado:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="cmbFiltroEstadoParcela" Width="170" Margin="0,0,16,0" SelectedIndex="0"
                      ToolTip="Filtra por estado" SelectionChanged="Filtro_Cambiado">
                <ComboBoxItem Content="Todos"/>
                <ComboBoxItem Content="Libre"/>
                <ComboBoxItem Content="Ocupado"/>
                <ComboBoxItem Content="Reservado"/>
                <ComboBoxItem Content="En reparación"/>
                <ComboBoxItem Content="Pendiente de limpieza"/>
            </ComboBox>
            <Button x:Name="btnLimpiarFiltros" Content="Limpiar filtros" Style="{StaticResource BotonNeutro}" Margin="0"
                    ToolTip="Quita la búsqueda y los filtros" Click="btnLimpiarFiltros_Click"/>
        </WrapPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="320" MinWidth="260"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DataGrid x:Name="dgParcelas" Grid.Row="0" SelectionChanged="dgParcelas_SelectionChanged"
                          MouseDoubleClick="dgParcelas_MouseDoubleClick" KeyDown="dgParcelas_KeyDown"
                          ToolTip="Doble clic para modificar · Supr para eliminar">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Código" Binding="{Binding Id}" Width="70"/>
                        <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                        <DataGridTextColumn Header="Categoría" Binding="{Binding TextoCategoria}" Width="90"/>
                        <DataGridTextColumn Header="m²" Binding="{Binding TamanoM2}" Width="55"/>
                        <DataGridTextColumn Header="Capacidad" Binding="{Binding Capacidad}" Width="80"/>
                        <DataGridTemplateColumn Header="Estado" Width="170" CellTemplate="{StaticResource PlantillaPastillaEstado}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="btnNuevaParcela" Content="➕ Nueva" Style="{StaticResource BotonPrincipal}" Margin="0,4,4,4"
                            ToolTip="Añadir una parcela (Ctrl+N)" Click="btnNuevaParcela_Click"/>
                    <Button x:Name="btnModificarParcela" Content="✎ Modificar" Style="{StaticResource BotonNeutro}" IsEnabled="False"
                            ToolTip="Modificar la parcela seleccionada (Intro)" Click="btnModificarParcela_Click"/>
                    <Button x:Name="btnEliminarParcela" Content="🗑 Eliminar" Style="{StaticResource BotonPeligro}" IsEnabled="False"
                            ToolTip="Eliminar la parcela seleccionada (Supr)" Click="btnEliminarParcela_Click"/>
                    <Button x:Name="btnVerDisponibilidad" Content="📅 Ver disponibilidad" Style="{StaticResource BotonNeutro}"
                            ToolTip="Abrir el calendario de disponibilidad" Click="btnVerDisponibilidad_Click"/>
                </StackPanel>
            </Grid>

            <GroupBox Grid.Column="2" Header="Ficha de la parcela">
                <Grid>
                    <TextBlock x:Name="lblFichaVaciaParcela" Style="{StaticResource TextoFichaVacia}"
                               Text="Selecciona una parcela de la tabla para ver su ficha"/>
                    <ScrollViewer x:Name="pnlFichaParcela" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="lblFichaNombreParcela" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <Border x:Name="pnlFichaEstadoParcela" Style="{StaticResource PastillaEstado}" Margin="0,6,0,8">
                                <TextBlock x:Name="lblFichaEstadoParcela" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock x:Name="lblFichaDatosParcela" TextWrapping="Wrap" LineHeight="20" FontWeight="Normal"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>
