<UserControl x:Class="CampingRobledal.Monitores.MonitoresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:CampingRobledal.Monitores"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1180"
             MinWidth="1024"
             MinHeight="560"
             Background="{StaticResource ColorFondo}"
             Focusable="True"
             PreviewKeyDown="MonitoresView_PreviewKeyDown">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="560" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <!-- ===================== Filtros ===================== -->
        <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <TextBox x:Name="txtBuscarMonitor"
                         Padding="10,6,34,6"
                         TextChanged="txtBuscarMonitor_TextChanged"
                         ToolTip="Busca por nombre o apellidos (Ctrl+F)" />
                <TextBlock x:Name="lblPlaceholderBuscar"
                           Text="Buscar monitor"
                           Foreground="{StaticResource ColorTextoSecundario}"
                           Margin="11,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False" />
                <Path Width="16"
                      Height="16"
                      Margin="0,0,10,0"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Stretch="Uniform"
                      Stroke="{StaticResource ColorTextoSecundario}"
                      StrokeThickness="1.6"
                      Data="M10,2 A8,8 0 1 0 10,18 A8,8 0 1 0 10,2 M16,16 L21,21" />
            </Grid>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Idioma:"
                           Style="{StaticResource TextoSecundario}"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0" />
                <ComboBox x:Name="cmbFiltroIdioma"
                          Width="150"
                          SelectionChanged="cmbFiltroIdioma_SelectionChanged"
                          ToolTip="Muestra solo los monitores que hablan el idioma elegido" />
            </StackPanel>

            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Disponibilidad:"
                           Style="{StaticResource TextoSecundario}"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0" />
                <ComboBox x:Name="cmbFiltroDisponibilidad"
                          Width="160"
                          SelectionChanged="cmbFiltroDisponibilidad_SelectionChanged"
                          ToolTip="Muestra solo los monitores con esa disponibilidad" />
            </StackPanel>
        </Grid>

        <!-- ===================== Tabla ===================== -->
        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <DataGrid x:Name="dgMonitores"
                          SelectionChanged="dgMonitores_SelectionChanged"
                          MouseDoubleClick="dgMonitores_MouseDoubleClick"
                          ToolTip="Selecciona un monitor para ver su ficha. Doble clic o Intro para modificarlo.">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nombre"
                                            Binding="{Binding NombreCompleto}"
                                            SortMemberPath="NombreCompleto"
                                            Width="1.5*"
                                            ElementStyle="{StaticResource TextoColumna}" />
                        <DataGridTextColumn Header="Especialidad"
                                            Binding="{Binding Especialidad}"
                                            SortMemberPath="Especialidad"
                                            Width="1.35*"
                                            ElementStyle="{StaticResource TextoColumna}" />
                        <DataGridTextColumn Header="Idiomas"
                                            Binding="{Binding IdiomasCorto}"
                                            SortMemberPath="IdiomasCorto"
                                            Width="0.85*"
                                            ElementStyle="{StaticResource TextoColumna}" />
                        <DataGridTextColumn Header="Disponibilidad"
                                            Binding="{Binding Disponibilidad}"
                                            SortMemberPath="Disponibilidad"
                                            Width="1.1*"
                                            ElementStyle="{StaticResource TextoColumna}" />
                    </DataGrid.Columns>
                </DataGrid>

                <Border x:Name="pnlSinResultados"
                        Background="{StaticResource ColorBlanco}"
                        BorderBrush="{StaticResource ColorBorde}"
                        BorderThickness="1"
                        Padding="24,18"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                    <TextBlock Text="Ningún monitor coincide con la búsqueda y los filtros."
                               Style="{StaticResource TextoSecundario}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               MaxWidth="420" />
                </Border>
            </Grid>

            <Grid Grid.Row="1" Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="btnNuevoMonitor"
                            Content="+ Nuevo monitor"
                            Style="{StaticResource BotonPrincipal}"
                            Click="btnNuevoMonitor_Click"
                            ToolTip="Da de alta un monitor nuevo (Ctrl+N)" />
                    <Button x:Name="btnModificar"
                            Content="Modificar"
                            Style="{StaticResource BotonNeutro}"
                            IsEnabled="False"
                            Click="btnModificar_Click"
                            ToolTip="Modifica el monitor seleccionado (Intro)" />
                    <Button x:Name="btnDarDeBaja"
                            Content="Dar de baja"
                            Style="{StaticResource BotonNeutro}"
                            Foreground="{StaticResource ColorPeligro}"
                            BorderBrush="{StaticResource ColorPeligro}"
                            IsEnabled="False"
                            Click="btnDarDeBaja_Click"
                            ToolTip="Da de baja al monitor seleccionado (Supr)" />
                </StackPanel>

                <TextBlock x:Name="lblRecuento"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Style="{StaticResource TextoSecundario}" />
            </Grid>
        </Grid>

        <!-- ===================== Ficha ===================== -->
        <GroupBox Grid.Row="1"
                  Grid.Column="2"
                  Header="Ficha de monitor"
                  Background="{StaticResource ColorFondoFicha}"
                  Padding="14"
                  Margin="0">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="pnlFicha"
                                DataContext="{Binding SelectedItem, ElementName=dgMonitores}"
                                Visibility="Collapsed">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="128" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Width="128"
                                    Height="150"
                                    Background="{StaticResource ColorBlanco}"
                                    BorderBrush="{StaticResource ColorBorde}"
                                    BorderThickness="1"
                                    VerticalAlignment="Top"
                                    ClipToBounds="True">
                                <Grid>
                                    <Image Source="/imagenes/monitores/silueta.png"
                                           Stretch="Uniform" />
                                    <Image x:Name="imgFotoMonitor"
                                           Source="{Binding Foto}"
                                           Stretch="UniformToFill">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Foto}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                <TextBlock Text="{Binding NombreCompleto}"
                                           Style="{StaticResource TituloFicha}" />
                                <TextBlock Text="{Binding Especialidad}"
                                           Style="{StaticResource SubtituloFicha}"
                                           Margin="0,2,0,10" />
                                <TextBlock Text="{Binding TelefonosTexto, StringFormat='Tel. {0}'}"
                                           Style="{StaticResource TextoValor}" />
                                <TextBlock Text="{Binding Email}"
                                           Style="{StaticResource TextoValor}"
                                           Margin="0,3,0,0" />
                                <TextBlock Text="{Binding ContratoTexto, StringFormat='Contrato: {0}'}"
                                           Style="{StaticResource TextoValor}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Idiomas" Style="{StaticResource TituloSeccion}" />
                        <TextBlock Text="{Binding IdiomasTexto}" Style="{StaticResource TextoValor}" />

                        <TextBlock Text="Formación" Style="{StaticResource TituloSeccion}" />
                        <TextBlock Text="{Binding Formacion}" Style="{StaticResource TextoValor}" />

                        <TextBlock Text="Restricciones de disponibilidad" Style="{StaticResource TituloSeccion}" />
                        <TextBlock Text="{Binding Restricciones}" Style="{StaticResource TextoValor}" />

                        <TextBlock Text="Actividades" Style="{StaticResource TituloSeccion}" />
                        <TextBlock Text="{Binding ActividadesTexto}" Style="{StaticResource TextoValor}" />

                        <Button x:Name="btnVerActividades"
                                Content="Ver sus actividades"
                                Style="{StaticResource BotonNeutro}"
                                HorizontalAlignment="Stretch"
                                Margin="0,14,0,0"
                                Click="btnVerActividades_Click"
                                ToolTip="Muestra las actividades que imparte el monitor seleccionado" />
                    </StackPanel>
                </ScrollViewer>

                <TextBlock x:Name="lblSinSeleccion"
                           Text="Selecciona un monitor de la tabla para ver su ficha."
                           Style="{StaticResource TextoSecundario}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           MaxWidth="260"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Grid>
        </GroupBox>

        <!-- ===================== Barra de estado ===================== -->
        <Border Grid.Row="2"
                Grid.ColumnSpan="3"
                Background="{StaticResource ColorPrimarioClaro}"
                BorderBrush="{StaticResource ColorBorde}"
                BorderThickness="1,0,0,0"
                Padding="10,7"
                Margin="0,12,0,0">
            <DockPanel>
                <TextBlock x:Name="lblResumen"
                           DockPanel.Dock="Right"
                           Style="{StaticResource TextoAyuda}" />
                <TextBlock x:Name="lblEstado"
                           Text="Listo"
                           Style="{StaticResource TextoSecundario}" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
