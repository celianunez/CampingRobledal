<Window x:Class="CampingRobledal.VentanaConfirmacion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirmar" Width="460" MinWidth="420" MinHeight="180" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource ColorFondo}" FontFamily="{StaticResource FuentePrincipal}"
        FontSize="{StaticResource TamanoTexto}" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="lblIcono" Grid.Column="0" Text="⚠" FontSize="34" Foreground="{StaticResource ColorAcento}"
                       VerticalAlignment="Top" Margin="0,0,14,0"/>
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="lblTitulo" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="lblMensaje" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="btnCancelar" Content="Cancelar" Style="{StaticResource BotonNeutro}" IsDefault="True"
                    ToolTip="No hacer nada y volver (Esc)" Click="btnCancelar_Click"/>
            <Button x:Name="btnDescartar" Content="Salir sin guardar" Style="{StaticResource BotonPeligro}" Visibility="Collapsed"
                    ToolTip="Salir y perder los cambios" Click="btnDescartar_Click"/>
            <Button x:Name="btnAccion" Content="Aceptar" Style="{StaticResource BotonPeligro}"
                    ToolTip="Confirmar la acción" Click="btnAccion_Click"/>
        </StackPanel>
    </Grid>
</Window>
