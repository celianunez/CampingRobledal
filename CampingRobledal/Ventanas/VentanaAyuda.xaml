<Window x:Class="CampingRobledal.VentanaAyuda"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ayuda · Camping El Robledal" Width="860" Height="580" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource ColorFondo}" FontFamily="{StaticResource FuentePrincipal}"
        FontSize="{StaticResource TamanoTexto}" Closed="Window_Closed">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" MinWidth="180"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBox x:Name="txtBuscarAyuda" Grid.Row="0" Margin="0,0,0,8"
                     ToolTip="Escribe una palabra para buscar en la ayuda, p. ej. reserva" TextChanged="txtBuscarAyuda_TextChanged"/>
            <ListBox x:Name="lstTemas" Grid.Row="1" ToolTip="Temas de ayuda" SelectionChanged="lstTemas_SelectionChanged"/>
        </Grid>

        <GroupBox Grid.Column="2" Header="Tema">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="lblTituloTema" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="lblContenidoTema" TextWrapping="Wrap" LineHeight="22" Margin="0,10,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </GroupBox>
    </Grid>
</Window>
