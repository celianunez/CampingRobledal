<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================== Texto ===================== -->
    <Style x:Key="TextoNormal" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FuenteApp}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource ColorTexto}" />
    </Style>

    <Style x:Key="TextoSecundario" TargetType="TextBlock" BasedOn="{StaticResource TextoNormal}">
        <Setter Property="Foreground" Value="{StaticResource ColorTextoSecundario}" />
    </Style>

    <Style x:Key="TextoAyuda" TargetType="TextBlock" BasedOn="{StaticResource TextoNormal}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource ColorTextoSecundario}" />
    </Style>

    <Style x:Key="TextoError" TargetType="TextBlock" BasedOn="{StaticResource TextoNormal}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource ColorPeligro}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,3,0,0" />
    </Style>

    <Style x:Key="TituloFicha" TargetType="TextBlock" BasedOn="{StaticResource TextoNormal}">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SubtituloFicha" TargetType="TextBlock" BasedOn="{StaticResource TextoNormal}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource ColorPrimario}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="TituloSeccion" TargetType="TextBlock" BasedOn="{StaticResource TextoNormal}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,14,0,4" />
    </Style>

    <Style x:Key="TextoValor" TargetType="TextBlock" BasedOn="{StaticResource TextoNormal}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="19" />
    </Style>

    <!-- ===================== Botones ===================== -->
    <Style x:Key="BotonBase" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource FuenteApp}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource ColorTexto}" />
        <Setter Property="Background" Value="{StaticResource ColorBlanco}" />
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="fondo"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="fondo" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="fondo" Property="Opacity" Value="0.74" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="fondo" Property="Opacity" Value="0.42" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BotonPrincipal" TargetType="Button" BasedOn="{StaticResource BotonBase}">
        <Setter Property="Background" Value="{StaticResource ColorPrimario}" />
        <Setter Property="BorderBrush" Value="{StaticResource ColorPrimario}" />
        <Setter Property="Foreground" Value="{StaticResource ColorBlanco}" />
    </Style>

    <Style x:Key="BotonPeligro" TargetType="Button" BasedOn="{StaticResource BotonBase}">
        <Setter Property="Background" Value="{StaticResource ColorPeligro}" />
        <Setter Property="BorderBrush" Value="{StaticResource ColorPeligro}" />
        <Setter Property="Foreground" Value="{StaticResource ColorBlanco}" />
    </Style>

    <Style x:Key="BotonNeutro" TargetType="Button" BasedOn="{StaticResource BotonBase}">
        <Setter Property="Background" Value="{StaticResource ColorBlanco}" />
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}" />
        <Setter Property="Foreground" Value="{StaticResource ColorTexto}" />
    </Style>

    <Style x:Key="BotonPequeno" TargetType="Button" BasedOn="{StaticResource BotonNeutro}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="MinHeight" Value="28" />
    </Style>

    <!-- ===================== Campos ===================== -->
    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource FuenteApp}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource ColorTexto}" />
        <Setter Property="Background" Value="{StaticResource ColorBlanco}" />
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource FuenteApp}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource ColorTexto}" />
        <Setter Property="Background" Value="{StaticResource ColorBlanco}" />
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,5" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="FontFamily" Value="{StaticResource FuenteApp}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource ColorTexto}" />
        <Setter Property="Background" Value="{StaticResource ColorBlanco}" />
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource FuenteApp}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource ColorTexto}" />
        <Setter Property="Margin" Value="0,0,18,8" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- ===================== GroupBox ===================== -->
    <Style TargetType="GroupBox">
        <Setter Property="FontFamily" Value="{StaticResource FuenteApp}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="{StaticResource ColorBlanco}" />
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                Background="{StaticResource ColorPrimarioClaro}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,1,1,0"
                                CornerRadius="4,4,0,0"
                                Padding="10,6">
                            <ContentPresenter ContentSource="Header"
                                              TextElement.FontSize="12"
                                              TextElement.FontWeight="SemiBold"
                                              TextElement.Foreground="{StaticResource ColorPrimario}" />
                        </Border>
                        <Border Grid.Row="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,0,1,1"
                                CornerRadius="0,0,4,4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Tabla ===================== -->
    <Style TargetType="DataGrid">
        <Setter Property="FontFamily" Value="{StaticResource FuenteApp}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource ColorTexto}" />
        <Setter Property="Background" Value="{StaticResource ColorBlanco}" />
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="RowHeight" Value="36" />
        <Setter Property="ColumnHeaderHeight" Value="38" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="#EDEDE8" />
        <Setter Property="AlternatingRowBackground" Value="{StaticResource ColorFilaAlterna}" />
        <Setter Property="AlternationCount" Value="2" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="CanUserSortColumns" Value="True" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="RowHeaderWidth" Value="0" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="FontFamily" Value="{StaticResource FuenteApp}" />
        <Setter Property="Background" Value="{StaticResource ColorPrimarioClaro}" />
        <Setter Property="Foreground" Value="{StaticResource ColorPrimario}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource ColorSeleccion}" />
                <Setter Property="Foreground" Value="{StaticResource ColorTexto}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource ColorSeleccion}" />
                <Setter Property="Foreground" Value="{StaticResource ColorTexto}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TextoColumna" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Foreground" Value="{StaticResource ColorTexto}" />
    </Style>

</ResourceDictionary>
