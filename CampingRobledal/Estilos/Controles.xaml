<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="4,3"/>
        <Setter Property="BorderBrush" Value="{StaticResource BordeNormal}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Padding" Value="4,3"/>
        <Setter Property="BorderBrush" Value="{StaticResource BordeNormal}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="GroupBox">
        <Setter Property="Background" Value="{StaticResource ColorPrimarioClaro}"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="FontSize" Value="{StaticResource TamanoGrupo}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#DDDDD5"/>
        <Setter Property="AlternatingRowBackground" Value="#F3F6F3"/>
        <Setter Property="RowHeight" Value="28"/>
    </Style>

    <!-- Mensaje de error junto a un campo (D-007) -->
    <Style x:Key="TextoError" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ColorPeligro}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Visibility" Value="Collapsed"/>
    </Style>

    <!-- Ayuda en gris junto a un campo -->
    <Style x:Key="TextoAyuda" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ColorTextoSecundario}"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style x:Key="TituloVentana" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TamanoTitulo}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Pastilla de estado: Border redondeado con color de fondo + texto -->
    <Style x:Key="PastillaEstado" TargetType="Border">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="8,1"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
</ResourceDictionary>
