<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Paleta de docs/guia-estilo.md -->
    <Color x:Key="Primario">#2E6B3F</Color>
    <SolidColorBrush x:Key="ColorPrimario" Color="#2E6B3F"/>
    <SolidColorBrush x:Key="ColorPrimarioClaro" Color="#E8F1EA"/>
    <SolidColorBrush x:Key="ColorAcento" Color="#B5703A"/>
    <SolidColorBrush x:Key="ColorFondo" Color="#FAFAF7"/>
    <SolidColorBrush x:Key="ColorTexto" Color="#222222"/>
    <SolidColorBrush x:Key="ColorTextoSecundario" Color="#666666"/>
    <SolidColorBrush x:Key="ColorPeligro" Color="#C62828"/>
    <SolidColorBrush x:Key="ColorExito" Color="#2E7D32"/>
    <SolidColorBrush x:Key="BordeNormal" Color="#B0B0A8"/>
    <SolidColorBrush x:Key="Blanco" Color="White"/>

    <!-- Estados de alojamiento -->
    <SolidColorBrush x:Key="EstadoLibre" Color="#2E7D32"/>
    <SolidColorBrush x:Key="EstadoOcupado" Color="#C62828"/>
    <SolidColorBrush x:Key="EstadoReservado" Color="#1565C0"/>
    <SolidColorBrush x:Key="EstadoReparacion" Color="#6D4C41"/>
    <SolidColorBrush x:Key="EstadoLimpieza" Color="#F9A825"/>
    <!-- Estados de reserva (Confirmada = EstadoReservado, Check-in = EstadoLibre, Anulada = EstadoOcupado) -->
    <SolidColorBrush x:Key="EstadoFinalizada" Color="#757575"/>

    <!-- Tamaños de texto (recursos para poder escalarlos con Preferencias) -->
    <FontFamily x:Key="FuentePrincipal">Segoe UI</FontFamily>
    <sys:Double x:Key="TamanoTexto">12</sys:Double>
    <sys:Double x:Key="TamanoGrupo">13</sys:Double>
    <sys:Double x:Key="TamanoTitulo">18</sys:Double>
</ResourceDictionary>
